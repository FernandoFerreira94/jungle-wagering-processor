{
  "name": "jungle-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test --timeout 60000 tests/integration",
    "test:concurrency": "bun test --timeout 180000 tests/concurrency",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:load": "bun load/load-test.ts",
    "demo": "docker compose exec app-1 bun scripts/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/postgresql": "^6",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "typescript": "^5"
  }
}
